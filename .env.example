# Banco de dados — Railway injeta DATABASE_URL automaticamente
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Seguranca — gere com: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=troque-aqui-minimo-64-chars

# Chave mestra para criptografia AES dos PDFs — gere com: python generate_keys.py
MASTER_ENCRYPTION_KEY=

# Ambiente
ENVIRONMENT=PROD

# Google Drive (opcional)
GOOGLE_DRIVE_FOLDER_ID=

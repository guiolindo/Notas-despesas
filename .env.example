# ─────────────────────────────────────────────────────────────────────────
# Economart Notas — variaveis de ambiente
# ─────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha. NUNCA versione .env real.

# ─── Banco de dados ──────────────────────────────────────────────────────
# Railway injeta DATABASE_URL automaticamente quando voce adiciona o plugin
# Postgres. Em DEV local, SQLite e suficiente:
#   DATABASE_URL=sqlite:///./economart.db
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# ─── Seguranca ───────────────────────────────────────────────────────────
# SECRET_KEY: chave de assinatura JWT (access + refresh tokens).
# Gere com: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=troque-aqui-minimo-64-chars

# MASTER_ENCRYPTION_KEY: chave Fernet (44 chars terminada em '=') usada para
# criptografar os PDFs no R2. Gere com: python generate_keys.py
# OBS: se rotacionar essa chave, os PDFs antigos viram lixo. Faca backup.
MASTER_ENCRYPTION_KEY=

# ─── Ambiente ────────────────────────────────────────────────────────────
# DEV | PROD. Em PROD, CSP fica mais restrita e cookies sao secure.
ENVIRONMENT=PROD

# ─── Sessao (opcional — defaults sao razoaveis) ──────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_BLOCK_MINUTES=10

# ─── Cloudflare R2 (storage criptografado dos PDFs) ──────────────────────
# Crie conta em dash.cloudflare.com -> R2 Object Storage -> Create bucket.
# Gere um Account API Token com 'Object Read & Write' no Cloudflare.
# Em DEV local, deixar vazio cai em uploads/ no disco.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=economart-notas-fiscais

# ─── Email — SMTP/Resend (apenas via env por seguranca) ─────────────────
# IMPORTANTE: a configuracao de email NAO existe na UI do admin. Foi movida
# pra ca pra impedir que um admin malicioso redirecione SMTP e intercepte
# codigos de reset de senha de outros admins/diretores.
# Quem operar essas variaveis (Railway) controla o envio.

# Provider: SMTP | RESEND | DISABLED
# - SMTP:     usa o servidor SMTP definido abaixo (Gmail, Outlook, Postmark, etc).
# - RESEND:   usa a API HTTP do Resend — recomendado no Railway (SMTP do
#             Gmail e bloqueado em Hobby; Resend funciona).
# - DISABLED: nao envia emails (uteis em DEV).
EMAIL_PROVIDER=DISABLED

# Remetente (vai no header From). Sem isso, email cai em SPAM.
SMTP_FROM_EMAIL=nao-responder@economart.com.br
SMTP_FROM_NAME=Economart

# Provider RESEND (HTTP API — preferido em Railway) ----------------------
# Crie conta em https://resend.com (free: 3000 emails/mes).
# Verifique seu dominio em Domains -> Add Domain (sem isso, Resend so manda
# de @resend.dev e cai em spam).
# Gere uma API key em API Keys -> Create API Key.
RESEND_API_KEY=

# Provider SMTP (alternativa direta) -------------------------------------
# Para Gmail: ative 2FA na conta, gere App Password em
#   https://myaccount.google.com/apppasswords
# Atencao: Railway Trial/Hobby BLOQUEIA porta 587 outbound. Em paid plan
# funciona.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
